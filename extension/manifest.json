{
  "manifest_version": 3,
  "name": "CoachStudyBuddy Portal Connector",
  "version": "0.9.0",
  "description": "Connect CoachStudyBuddy to your signed-in university courses and lecture materials.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://coach.mastersunion.org/*",
    "https://coachstudybuddy.vercel.app/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import course materials"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coachstudybuddy.vercel.app/*",
        "http://127.0.0.1:3001/*",
        "http://localhost:3001/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ]
}